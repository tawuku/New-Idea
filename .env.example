# ============================================================
# Nexus Workspace — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────
# cPanel: use the Postgres connection string from your host's DB manager.
# Free external Postgres: https://neon.tech  or  https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/nexus_dev?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/nexus_dev?sslmode=require

# ── Redis (optional — used for rate-limit & presence) ─────────
# cPanel: leave blank to skip Redis. Add later for scale.
# Free option: https://upstash.com (use REST URL + token below)
REDIS_URL=
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (optional — leave blank to disable)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Email via SMTP (cPanel / Roundcube) ──────────────────────
# cPanel mail settings — find in: cPanel > Email Accounts > Connect Devices
# Outgoing (SMTP): mail.yourdomain.com  port 587 (STARTTLS) or 465 (SSL)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
# The cPanel email address you created (e.g. noreply@yourdomain.com)
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password
# Display name + address shown to recipients
EMAIL_FROM=Nexus <noreply@yourdomain.com>

# ── File Uploads (local disk — works on cPanel) ──────────────
# Absolute path to the uploads folder on your server.
# cPanel example: /home/yourusername/public_html/nexus-uploads
# Must be writable by the Node.js process.
UPLOAD_DIR=./uploads
# The public URL that maps to UPLOAD_DIR
# cPanel: if uploads lives in public_html/nexus-uploads, use:
# UPLOAD_PUBLIC_URL=https://yourdomain.com/nexus-uploads
UPLOAD_PUBLIC_URL=http://localhost:3001/uploads

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── AI (optional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Feature flags ─────────────────────────────────────────────
ENABLE_MFA=false
ENABLE_MEET=false
