# ============================================================
# Nexus Workspace — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# ── Database (Supabase / Neon / local Postgres) ───────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_dev
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/nexus_dev

# ── Redis (Upstash for dev, local Redis for local) ───────────
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ── Auth ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@nexus.dev

# ── Object Storage (Cloudflare R2 / S3-compatible) ───────────
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=nexus-dev
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000/nexus-dev

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

# ── AI (optional at Phase 0) ─────────────────────────────────
ANTHROPIC_API_KEY=

# ── Feature flags ────────────────────────────────────────────
ENABLE_MFA=false
ENABLE_MEET=false
