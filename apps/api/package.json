{
  "name": "@nexus/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@nexus/config": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/schemas": "workspace:*",
    "better-auth": "^1.2.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.2",
    "ioredis": "^5.10.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.3",
    "zod": "^4.0.0",
    "nodemailer": "^6.9.17",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@types/nodemailer": "^6.4.17"
  }
}
