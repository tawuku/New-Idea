# ── Local Docker dev defaults — copy to .env.local ──────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus_dev
DATABASE_URL_UNPOOLED=postgresql://nexus:nexus_dev@localhost:5432/nexus_dev

REDIS_URL=redis://localhost:6379

# Any 32+ char string is fine for local dev
BETTER_AUTH_SECRET=local-dev-secret-at-least-32-chars-ok

BETTER_AUTH_URL=http://localhost:3000

# Leave SMTP blank → emails print to terminal stdout instead of sending
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nexus <noreply@localhost>

UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:3001/uploads
